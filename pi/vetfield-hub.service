[Unit]
Description=VetField Cart Hub Server
After=network.target gpsd.service
Wants=gpsd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/vetfield-hub
ExecStart=/usr/bin/node /opt/vetfield-hub/hub-server.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vetfield-hub

# Wait for UWB modules to enumerate
ExecStartPre=/bin/sleep 5

Environment=WS_PORT=8765
Environment=HTTP_PORT=8766

# ── UWB Architecture ────────────────────────────────────────────────────────
# "cart"   = antennas mounted on cart, ranging to ball tags (PRODUCTION)
# "anchor" = fixed anchors around the hole, gateway sends absolute positions
# "tag"    = single ranging tag, distance-only fallback
Environment=UWB_MODE=cart
Environment=UWB_PORT=/dev/uwb-gateway0
Environment=UWB_BAUD=115200

# UWB tag IDs embedded in the golf balls
Environment=BALL_IDS=ball1,ball2,ball3,ball4

# ── Cart antenna offsets (metres, cart frame, +x forward, +y left) ───────────
# Default 3-antenna "T" pattern on cart roof:
#   A1 front-left, A2 front-right, A3 rear-centre.
# Override here to match your physical antenna mounting.
Environment=ANT_OFFSET_A1=0.6,0.5
Environment=ANT_OFFSET_A2=0.6,-0.5
Environment=ANT_OFFSET_A3=-0.6,0.0
# Optional 4th antenna for redundancy:
# Environment=ANT_OFFSET_A4=0.0,0.0

# ── Heading source ───────────────────────────────────────────────────────────
# Set IMU_ENABLE=true to use I2C magnetometer (HMC5883L / QMC5883L on /dev/i2c-1).
# Otherwise heading is derived from GPS course-over-ground (only valid when
# the cart is moving > 0.5 m/s).
Environment=IMU_ENABLE=false

# ── Course frame anchor (calibrate per course) ──────────────────────────────
# COURSE_LAT0/LNG0 = GPS coordinates of the (0,0) corner of the course bounding
# box. COURSE_HEADING_DEG = compass bearing of the +x axis.
# Update these when deploying to a new course.
Environment=COURSE_LAT0=0
Environment=COURSE_LNG0=0
Environment=COURSE_HEADING_DEG=0
Environment=FIELD_SIZE_M=150

# ── Test mode (no hardware required) ────────────────────────────────────────
# Environment=SIMULATE=true

[Install]
WantedBy=multi-user.target
